{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "刚刚好影工",
  "version": "0.1.0",
  "identifier": "com.qingya.video-compressor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5188",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5188 --strictPort",
    "beforeBuildCommand": "npm run prepare:ffmpeg && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "刚刚好影工",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
