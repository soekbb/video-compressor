{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "刚刚好影工默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-stat",
    "allow-compress-video",
    "allow-prepare-compress-batch",
    "allow-cancel-compress",
    "allow-merge-videos",
    "allow-list-drama-folders",
    "allow-load-auto-state",
    "allow-save-auto-state",
    "allow-list-tasks",
    "allow-upsert-task",
    "allow-delete-task",
    "allow-delete-finished-tasks",
    "allow-mark-stale-tasks",
    "allow-load-settings",
    "allow-save-settings",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
